#!/usr/bin/env bash
# Launch cellpy-simple-gui from the repo root.
# Usage: ./run [--server] [--no-open] [--port N]
set -euo pipefail
cd "$(dirname "$0")"
echo "Launching cellpy-simple-gui from $(pwd)"
echo "Using uv $(uv --version)"
echo "It sometimes takes a while to start the server..."
exec uv run --extra export --extra desktop cellpy-simple-gui "$@"
